# Grid-IQ environment — the single list of every variable any service reads.
# PLACEHOLDERS ONLY. Never commit a real .env (all .env files are gitignored).
#
# Docker Compose (the normal way to run the stack, locally and on the server):
#   cp .env.example .env        # docker compose reads ./.env
# compose builds DATABASE_URL, service URLs and MQTT_BROKER_URL itself from
# the values below; the "npm run dev" section only applies outside Docker.
#
# npm run dev (services on the host, no containers): also copy this file to
#   services/auth-service/.env, services/ingestion-service/.env,
#   services/api-gateway/.env, and
#   echo "NEXT_PUBLIC_API_URL=http://localhost:8081" > apps/web/.env.local
# Each service ignores the variables it doesn't use.
#
# Generate secrets with:  openssl rand -hex 32
# Use hex for POSTGRES_PASSWORD: it is embedded in a postgres:// URL.

# ── Docker Compose: domains and data ────────────────────────────────────────
# Caddy serves the app on APP_DOMAIN and obtains the MQTT_DOMAIN certificate
# that Mosquitto uses on 8883. Local dev: localhost / mqtt.localhost (Caddy's
# local CA). Server: app.<domain> / mqtt.<domain>.
APP_DOMAIN=localhost
MQTT_DOMAIN=mqtt.localhost
# Persistent data: pg/ caddy/ mosquitto/data/ mqtt-certs/ uploads/. Server: /data
DATA_DIR=./.data
# Tag for locally built images (gridiq/<service>:<tag>)
IMAGE_TAG=local

# ── Database (docker compose: timescaledb) ──────────────────────────────────
# Only applied when the DB volume is first created.
POSTGRES_USER=powerguard_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=powerguard_db

# ── Database (auth-service, ingestion-service) — REQUIRED for npm run dev ───
# Services exit at startup if this is missing. Docker Compose sets it itself.
DATABASE_URL=postgres://powerguard_user:change_me@localhost:5432/powerguard_db

# ── Authentication (auth-service, ingestion-service, api-gateway) — REQUIRED ─
# At least 32 characters and identical in every service.
JWT_SECRET=change_me_to_at_least_32_random_characters
# Adds Secure to the auth cookie. Docker Compose defaults it to true (Caddy
# serves HTTPS); keep false for npm run dev over plain http.
COOKIE_SECURE=false

# ── Service ports (each service has its own default) ────────────────────────
# auth-service 3001, ingestion-service 3002, api-gateway 8081
PORT=

# ── API gateway (npm run dev; compose derives these) ────────────────────────
FRONTEND_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:3001
INGESTION_SERVICE_URL=http://localhost:3002
# Proxy hops to trust for the client IP (rate limiting). Compose sets 1 (Caddy).
TRUST_PROXY=

# ── Ingestion service roles and storage ─────────────────────────────────────
# Comma-separated: api (REST endpoints), ingest (MQTT → DB), jobs
# (cron). Default all three for npm run dev; compose runs one per container.
ROLES=api,ingest,jobs
# Internal /health port for ingest-only and jobs-only containers
HEALTH_PORT=9090
# CSV staging and SLD PDFs. Compose mounts ${DATA_DIR}/uploads at /data/uploads.
# npm run dev: a relative path resolves against services/ingestion-service.
UPLOAD_DIR=./uploads

# ── MQTT (ingestion-service) ────────────────────────────────────────────────
# Compose uses mqtts://${MQTT_DOMAIN}:8883 (resolved inside the compose
# network). This URL is for npm run dev only.
MQTT_BROKER_URL=mqtt://localhost:1883
# The ingest user; must match the "user" line in mosquitto/config/acl.
MQTT_USERNAME=gridiq-ingest
MQTT_PASSWORD=change_me
# Only needed for mqtts:// with a private CA (local dev: see docker-compose.override.yml.example)
MQTT_CA_CERT=
MQTT_TLS_REJECT_UNAUTHORIZED=true
# Persistent MQTT session id of the ingest role. Keep it stable: the broker
# queues QoS 1 messages for this id while ingest is down.
MQTT_CLIENT_ID=gridiq-ingest

# ── Ingest batching and events (ingestion-service, ingest role) ─────────────
# Flush the reading queue every INGEST_FLUSH_MS or at INGEST_FLUSH_ROWS rows.
INGEST_FLUSH_MS=1000
INGEST_FLUSH_ROWS=500
# Queue bound: when full, ingest stops reading from the broker (backpressure).
INGEST_MAX_QUEUE=50000
# An ongoing voltage/frequency excursion is written to pq_events after this long.
EVENT_MIN_SECONDS=3
# Log every MQTT message (noisy at 1 Hz; a per-minute summary is always logged).
INGEST_LOG_MESSAGES=false

# ── Retention windows (ingestion-service, migrate) ──────────────────────────
# Device timestamps older than MAX_BACKFILL_DAYS fall back to arrival time, so
# it must cover the AXM-WEB2 store-and-forward buffer depth. Raw data is
# compressed, and the continuous aggregates stop refreshing, after
# COMPRESS_AFTER_DAYS, which must be greater. The migrate step applies changes
# to the database; services refuse to start until it has.
MAX_BACKFILL_DAYS=14
COMPRESS_AFTER_DAYS=15

# ── Alerting (ingestion-service, jobs role) ─────────────────────────────────
# A meter that has sent nothing for this long raises METER_SILENT.
METER_SILENT_MINUTES=5
# pq_events shorter than this do not alert (per site: site_settings.event_alert_min_s).
EVENT_ALERT_MIN_SECONDS=10

# ── AI (ingestion-service recommendations/narratives, web chat route) ───────
# AI features are skipped when the key is empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_CHAT_MODEL=gpt-5.4

# ── Web (apps/web) ──────────────────────────────────────────────────────────
# Baked into the client bundle at BUILD time, not read at runtime. The build
# fails without it. Compose passes https://${APP_DOMAIN}/api as a build arg.
NEXT_PUBLIC_API_URL=http://localhost:8081

# ── Backups (deploy/scripts/backup.sh, restore-drill.sh) ────────────────────
# Cloudflare R2 (chosen): endpoint https://<account_id>.r2.cloudflarestorage.com,
# region auto, an R2 API token with Object Read & Write on this one bucket only.
# Any other S3-compatible store works the same way.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
BACKUP_PREFIX=gridiq
# Backups are encrypted with age before upload (docs/RUNBOOK.md → Backup key).
# Public key (age1...): safe to keep here, it can only encrypt.
BACKUP_AGE_RECIPIENT=
# Private key, root-only on the server; used by the restore drill.
BACKUP_AGE_IDENTITY_FILE=/etc/gridiq/backup-age.key
# true uploads unencrypted dumps when no recipient is set. Local tests only.
BACKUP_ALLOW_UNENCRYPTED=false

# ── Feature flags ───────────────────────────────────────────────────────────
# Broker portfolio (/broker pages, broker API routes, renewal sweep). Kept in
# the code, off by default. Changing it means rebuilding web.
FEATURE_BROKER=false
# PV sizer, the simulation tab, savings and "What we caught" (/dashboard
# tools). Sizing is the feasibility company's job (plan Part E); off by default.
# Changing it means rebuilding web.
FEATURE_TOOLS=false

# ── Deep health (api role, /api/health/deep) ────────────────────────────────
HEALTH_MAX_FLUSH_AGE_S=300
HEALTH_MAX_BACKUP_AGE_H=26
# Static token for the external uptime monitor (header x-health-token).
# Empty disables the endpoint. Generate with: openssl rand -hex 32
HEALTH_TOKEN=
# (keep a comment after an empty secret: the secrets scanner reads the next
#  line as its value otherwise)
# false on machines without backups (local dev), so health is not always 503
HEALTH_REQUIRE_BACKUP=true

# ── Demo seed scripts (local dev only) ──────────────────────────────────────
# scripts/seed.ts, scripts/fix_password.ts and services/auth-service/src/seed.ts
# refuse to run unless ALLOW_DEMO_SEED=true. Never set this on a server.
ALLOW_DEMO_SEED=false
DEMO_USER_PASSWORD=
