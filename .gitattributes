# Force LF line endings for shell scripts and systemd unit files — they fail
# on Linux with `\r\n` endings ("/bin/bash^M: bad interpreter").
*.sh        text eol=lf
*.service   text eol=lf
start.sh    text eol=lf

# Default: let git auto-detect text/binary, normalize to LF on commit.
* text=auto
# Sample deliverables: byte-exact (their SHA-256 is in manifest.json)
docs/gridiq/samples/** -text
