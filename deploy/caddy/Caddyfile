{$APP_DOMAIN} {
	encode zstd gzip

	# The Next.js AI chat route lives under /api too; it belongs to web, not
	# the gateway. Must come before the /api/* block.
	handle /api/chat* {
		reverse_proxy web:3000
	}

	handle_path /api/* {
		reverse_proxy gateway:8081
	}

	reverse_proxy web:3000
}

# Exists only so Caddy obtains and renews the certificate Mosquitto uses
# (copied by deploy/scripts/sync-mqtt-certs.sh).
{$MQTT_DOMAIN} {
	respond "Grid-IQ MQTT endpoint" 200
}
