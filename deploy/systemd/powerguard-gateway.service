[Unit]
Description=PowerGuard API Gateway (reverse proxy, port 8081)
Documentation=https://github.com/vitaltrading09/JMC-Ventures
After=network-online.target powerguard-auth.service powerguard-ingestion.service
Wants=network-online.target powerguard-auth.service powerguard-ingestion.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/PowerGuard
EnvironmentFile=/home/ubuntu/PowerGuard/services/api-gateway/.env

ExecStart=/bin/bash -lc 'exec npx tsx services/api-gateway/src/main.ts'

Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

MemoryMax=256M
TasksMax=200

StandardOutput=journal
StandardError=journal
SyslogIdentifier=powerguard-gateway

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
