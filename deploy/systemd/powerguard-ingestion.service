[Unit]
Description=PowerGuard Ingestion Service (MQTT + API, port 3002)
Documentation=https://github.com/vitaltrading09/JMC-Ventures
After=network-online.target docker.service powerguard-auth.service
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/PowerGuard
EnvironmentFile=/home/ubuntu/PowerGuard/services/ingestion-service/.env

ExecStart=/bin/bash -lc 'exec npx tsx services/ingestion-service/src/main.ts'

Restart=always
RestartSec=5

# Ingestion holds MQTT connection + cron jobs + queue worker — give it more headroom.
MemoryMax=768M
TasksMax=500

StandardOutput=journal
StandardError=journal
SyslogIdentifier=powerguard-ingestion

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
