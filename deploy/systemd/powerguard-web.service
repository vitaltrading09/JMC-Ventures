[Unit]
Description=PowerGuard Web Frontend (Next.js, port 3000)
Documentation=https://github.com/vitaltrading09/JMC-Ventures
After=network-online.target powerguard-gateway.service
Wants=network-online.target powerguard-gateway.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/PowerGuard/apps/web

# Next.js production server reads from .next/ — must run `npm run build` first.
# The install script does this; if you redeploy code, run `bash deploy/scripts/rebuild-web.sh`.
ExecStart=/bin/bash -lc 'exec npm run start'

Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Next.js is the heaviest — SSR rendering can balloon. 1GB cap.
MemoryMax=1G
TasksMax=500

StandardOutput=journal
StandardError=journal
SyslogIdentifier=powerguard-web

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
