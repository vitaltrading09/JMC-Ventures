{
    "name": "@gridiq/db",
    "version": "1.0.0",
    "private": true,
    "description": "Grid-IQ database migrations (node-pg-migrate, plain SQL), shared schema constants and the startup schema check.",
    "main": "index.js",
    "types": "index.d.ts",
    "bin": {
        "gridiq-migrate": "bin/migrate.js"
    },
    "scripts": {
        "test": "node --test test/*.test.js",
        "migrate": "node bin/migrate.js up",
        "migrate:status": "node bin/migrate.js status",
        "migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language sql"
    },
    "dependencies": {
        "node-pg-migrate": "9.0.0",
        "pg": "^8.11.3"
    }
}
