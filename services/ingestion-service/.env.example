# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://powerguard_user:powerguard_password@localhost:5432/powerguard_db

# ── Redis (BullMQ queue backend) ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── MQTT Broker ─────────────────────────────────────────────────────────────
# Plain TCP (development / internal network):
MQTT_BROKER_URL=mqtt://localhost:1883

# TLS (production — set to port 8883 and configure Mosquitto with certs):
# MQTT_BROKER_URL=mqtts://broker.powerguard.co.za:8883

# Per-device credentials set in mosquitto.passwd
MQTT_USERNAME=acuvim_meter
MQTT_PASSWORD=change_me_in_production

# TLS: path to Mosquitto CA certificate (only needed for mqtts://)
# MQTT_CA_CERT=/etc/ssl/certs/mosquitto-ca.crt
# MQTT_TLS_REJECT_UNAUTHORIZED=true

# ── Authentication ───────────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_in_production_minimum_32_chars

# ── AI (Claude) ─────────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Service ──────────────────────────────────────────────────────────────────
PORT=3002
FRONTEND_URL=http://localhost:3000
